TAVUS_API_KEY=
# Optional. Reuse an existing PAL; leave empty to create a temporary PAL for each call.
TAVUS_PAL_ID=
# Required only when TAVUS_PAL_ID is empty.
TAVUS_FACE_ID=
TAVUS_MAX_CALL_DURATION=600
RECALL_API_KEY=
RECALL_REGION=us-east-1

# Optional local app port. Defaults to 3000.
PORT=3000
